# ─── FD Rate Scraper — Environment Configuration ────────────────────────────
# Copy this file to .env and adjust values as needed.

# Database connection string (SQLite default works out of the box)
DATABASE_URL=sqlite:///./fd_rates.db

# Daily scraping schedule (24-hour format)
SCRAPE_HOUR=8
SCRAPE_MINUTE=0

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API server bind address
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated handled by pydantic-settings)
CORS_ORIGINS=["http://localhost:3000"]
